# The only required setting.
ANTHROPIC_API_KEY=

# Everything below is optional; defaults shown.
# BASE_DOMAIN=localhost          # apps are served at http://<runId>.apps.<BASE_DOMAIN>
# HTTP_PORT=80                  # host port; app URLs include it when not 80
# RUN_BUDGET_USD=15              # hard cap per prompt
# DAILY_SPEND_CAP_USD=100        # refuse new runs once today's spend reaches this
# RUNS_PER_IP_PER_DAY=3
# MAX_CONCURRENT_RUNS=1
# FACTORY_MODEL=                # unset: Sonnet 5.5 for docs/review, Opus 5.5 for design/code; set to force one model everywhere
# LIBRARIAN=on                  # off: agents get no librarian tools (for comparing runs with and without)
# LIBRARIAN_LESSONS=on          # off: stop storing new lessons from repair agents
# CUSTOMER_QUESTIONS=on         # off: agents never ask the customer; runs never pause
# CUSTOMER_TIMEOUT_MINUTES=15   # how long a run waits for answers before using the agents' own choices
# REVISION_BUDGET_USD=5         # budget for one feedback round on a deployed app
# MAX_REVISIONS=5               # feedback rounds per app
# PRD_GATES=advisory            # repair: testability, scope and prompt-coverage problems are sent back to the requirements agent
# ACCEPTANCE_MODE=advisory      # blocking: failing independent acceptance tests fail verify and go to a fix round
# BENCHMARK_TOKEN=              # 16+ chars; lets scripts/benchmark.ts skip the per-IP run limit (not the spend cap)
